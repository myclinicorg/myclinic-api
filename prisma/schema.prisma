generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELED
}

enum TransactionCategory {
  SERVICE
  PRODUCT_SALE
  SUPPLIES
  RENT
  UTILITIES
  TAXES
  EQUIPMENT
  MARKETING
  OTHER
}

enum PaymentMethod {
  PIX
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  BANK_SLIP
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String?  @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic?

  @@map("users")
}

model Session {
  id           String   @id
  userId       String   @map("user_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(3)
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id          String   @id
  purpose     String
  userId      String   @map("user_id")
  email       String
  fingerprint String?
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

model Clinic {
  id                String   @id @default(uuid())
  ownerId           String   @unique @map("owner_id")
  name              String
  cnpj              String   @unique
  description       String?
  phone             String?
  contactEmail      String?  @map("contact_email")
  zipCode           String?  @map("zip_code")
  street            String?
  streetNumber      String?  @map("street_number")
  neighborhood      String?
  addressComplement String?  @map("address_complement")
  city              String?
  state             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  patients       Patient[]
  services       Service[]
  appointments   Appointment[]
  supplies       Supply[]
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@map("clinics")
}

model Patient {
  id                String    @id @default(uuid())
  clinicId          String    @map("clinic_id")
  fullName          String    @map("full_name")
  cpf               String
  sex               String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  email             String?
  phone             String?
  notes             String?
  zipCode           String?   @map("zip_code")
  street            String?
  streetNumber      String?   @map("street_number")
  neighborhood      String?
  addressComplement String?   @map("address_complement")
  city              String?
  state             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@unique([clinicId, cpf])
  @@index([clinicId, fullName])
  @@map("patients")
}

model Service {
  id              String   @id @default(uuid())
  clinicId        String   @map("clinic_id")
  name            String
  description     String?
  priceCents      Int      @map("price_cents")
  durationMinutes Int      @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id           String            @id @default(uuid())
  clinicId     String            @map("clinic_id")
  patientId    String            @map("patient_id")
  serviceId    String            @map("service_id")
  startsAt     DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime          @map("ends_at") @db.Timestamptz(3)
  priceCents   Int               @map("price_cents")
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(3)
  canceledAt   DateTime?         @map("canceled_at") @db.Timestamptz(3)
  cancelReason String?           @map("cancel_reason")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  transaction    Transaction?
  stockMovements StockMovement[]

  @@index([clinicId, startsAt])
  @@index([patientId])
  @@map("appointments")
}

model Supply {
  id              String   @id @default(uuid())
  clinicId        String   @map("clinic_id")
  name            String
  description     String?
  unit            String
  currentQuantity Decimal  @default(0) @map("current_quantity") @db.Decimal(12, 3)
  minQuantity     Decimal  @default(0) @map("min_quantity") @db.Decimal(12, 3)
  unitCostCents   Int?     @map("unit_cost_cents")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  @@index([clinicId, name])
  @@map("supplies")
}

model StockMovement {
  id            String            @id @default(uuid())
  clinicId      String            @map("clinic_id")
  supplyId      String            @map("supply_id")
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  unitCostCents Int?              @map("unit_cost_cents")
  reason        String?
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  appointmentId String?           @map("appointment_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supply        Supply            @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  transaction Transaction?

  @@index([supplyId, occurredAt])
  @@index([clinicId, occurredAt])
  @@map("stock_movements")
}

model Transaction {
  id              String              @id @default(uuid())
  clinicId        String              @map("clinic_id")
  type            TransactionType
  category        TransactionCategory
  description     String?
  amountCents     Int                 @map("amount_cents")
  status          TransactionStatus   @default(PENDING)
  dueDate         DateTime            @map("due_date") @db.Date
  paidAt          DateTime?           @map("paid_at") @db.Timestamptz(3)
  paymentMethod   PaymentMethod?      @map("payment_method")
  appointmentId   String?             @unique @map("appointment_id")
  stockMovementId String?             @unique @map("stock_movement_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic          Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  stockMovement   StockMovement?      @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([clinicId, dueDate])
  @@index([clinicId, paidAt])
  @@index([clinicId, type, status])
  @@map("transactions")
}
